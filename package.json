{
  "name": "wowmax-benchmarks",
  "version": "0.1.0",
  "description": "Public black-box test suite and performance benchmarks for the WOWMAX aggregation stack (Stellar DEX router, multi-bridge aggregator).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "bench": "tsx bench/run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
